# ==============================================================================
# Quiz Platform — Production Environment Configuration
# Target Domain: https://quiz.hoclieu.id.vn (portable to TUAF 10.64.11.109)
# ==============================================================================

# PostgreSQL connection string (Option A — shared PostgreSQL 15 instance,
# isolated database `quiz_db` and dedicated non-superuser `quiz_user`).
# Leave empty ONLY for local single-node dev/testing (falls back to ./config).
# Example on TUAF Server (`tuaf-ai-network`):
#   DATABASE_URL=postgresql://quiz_user:CHANGE_ME@tuaf-supabase-db:5432/quiz_db
DATABASE_URL=

# Super Admin bootstrap credentials (created automatically on first startup
# if no admin account exists yet in PostgreSQL).
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME="Quản trị hệ thống"
ADMIN_PASSWORD=

# Optional: Initial invite code enabling lecturers to self-register at /manager.
# Can also be toggled/changed anytime inside the Admin "Tài khoản" tab.
TEACHER_INVITE_CODE=

# Optional: OpenAI-compatible AI Provider for automatic question generation.
# Can also be managed/toggled anytime inside the Super Admin dashboard.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gemini-3-flash-preview

# Required in production: Signs JWT session & join tokens (min 32 characters).
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Legacy single-password fallback (optional; ADMIN_PASSWORD takes precedence).
MANAGER_PASSWORD=

# Maximum uploaded media size per image/audio/video file in MB (default: 100).
MAX_MEDIA_SIZE_MB=100

# Production host port mapped to container port 3000 (verified free on 10.64.11.109: 3600).
# For Cloudflare Tunnel on 10.64.11.109, point quiz.hoclieu.id.vn -> http://10.64.11.109:3600
QUIZ_PORT=3600

# Local dev ports only (inside Docker, Nginx listens on 3000 and Socket on 3001).
WEB_PORT=
SOCKET_PORT=
